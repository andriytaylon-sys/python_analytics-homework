{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"1FYGtuL6TnoN6uqfZUnnQtLpBorsRUAg-","timestamp":1776697897818}],"authorship_tag":"ABX9TyPW2lUE2CBn5Vx9c6AED+TZ"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"Kl674ziObr-u"},"outputs":[],"source":["import pandas as pd\n","pd.set_option('display.max_columns', None)\n","pd.set_option('display.max_rows',50)\n","pd.set_option('display.width', 1000 )\n","\n","df= pd.read_csv('applications(2.0).csv')\n","print(df.head(10))\n","\n","\n","ind_df = pd.read_csv('industries(2.0).csv')\n","print(ind_df.head(10))\n","apps_df = df.drop_duplicates(subset='applicant_id')\n","\n","before=len(df)\n","df = df.drop_duplicates(subset='applicant_id')\n","after=len(apps_df)\n","print(f\"Видалено{before-after}дублікатів\")\n","\n","apps_df['External Rating']=apps_df['External Rating'].fillna(0)\n","apps_df['Education level']=apps_df['Education level'].fillna('Середня')\n","\n","apps_df = pd.merge(apps_df, ind_df, how='left', on='Industry')\n","\n","\n","apps_df['Applied at'] = pd.to_datetime(apps_df['Applied at'],format='mixed')\n","apps_df['Applied on day'] = apps_df['Applied at'].dt.day_name()\n","print(apps_df.head(10))\n","\n","apps_df['Age']= apps_df['Age'].astype(int)\n","\n","\n","\n","age = ((apps_df['Age'] >= 35) & (apps_df['Age'] <= 55) * 20)\n","\n","day = (apps_df['Applied on day']).isin(['Saturday','Sunday'])* 20\n","\n","Marital_status = (apps_df['Marital status'] == 'Married')*20\n","\n","Location = (apps_df['Location']== 'Київ чи Київська область')*20\n","\n","Industry=apps_df['Score'].fillna(0)\n","apps_df['External Rating'] = apps_df['External Rating'] + Industry\n","\n","positive_rating=(apps_df['External Rating']>= 7) * 20\n","apps_df['External Rating'] = apps_df['External Rating'] + positive_rating\n","\n","negative_rating=(apps_df['External Rating']<= 2) *  -20\n","apps_df['External Rating'] = apps_df['External Rating'] - negative_rating\n","\n","apps_df['Final Score'] = (apps_df['External Rating'])+age+day+Marital_status+Location+Industry+positive_rating+negative_rating\n","\n","\n","valid_mask= (apps_df['Amount'].notna())&(apps_df['External Rating'] !=0)\n","apps_df['Final Score']= apps_df['Final Score'] * valid_mask\n","apps_df= apps_df.sort_values(by=['Final Score'], ascending=False)\n","\n","\n","accepted_apps = apps_df[apps_df['Final Score'] > 0].copy()\n","accepted_apps['Applied at'] = pd.to_datetime(accepted_apps['Applied at'])\n","accepted_apps['Week Number'] = accepted_apps['Applied at'].dt.isocalendar().week\n","weekly_report = accepted_apps.groupby('Week Number')['Final Score'].mean()\n","print(\"Середній рейтинг прийнятих заявок за тижнями:\")\n","print(weekly_report)"]}]}